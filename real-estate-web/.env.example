# Copia este archivo a .env.local y completa con las credenciales de tu proyecto
# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Emails de invitación a corredora (ruta server /api/invite/send)
# Server-only: en Cloudflare ve a Workers → Settings → Variables.
RESEND_API_KEY=re_...
FROM_EMAIL=MapU <no-reply@tudominio.cl>

