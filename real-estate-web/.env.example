# Copia este archivo a .env.local y completa con las credenciales de tu proyecto
# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Geocodificación (opcional). Por defecto usa Nominatim público (sin key).
# Apunta a un Nominatim self-hosted/proxy o a otro proveedor compatible.
# NEXT_PUBLIC_GEOCODING_URL=https://tu-nominatim.example.com

# SOLO server (nunca en el cliente): key service_role para /api/publish.
# Secret en el hosting (Cloudflare). Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags del mapa (ver docs/PLAN-MAPA.md). Apagados por defecto:
# solo "true" o "1" los encienden. Se borran cuando la fase queda fija.
# NEXT_PUBLIC_FEATURE_CONTEXTO=false
# NEXT_PUBLIC_FEATURE_MIS_LUGARES=false
# NEXT_PUBLIC_FEATURE_VALOR=false
